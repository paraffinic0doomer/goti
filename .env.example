# ============================================================================
#  Goti — environment template
#
#  Copy to `.env` and fill in. NEVER commit a real `.env`.
#  Every value here has a safe local default except the secrets.
# ============================================================================

NODE_ENV=development
PORT=3000

# Access-token signing. Generate at least 32 random bytes and never commit it.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=goti-api
JWT_AUDIENCE=goti-client

# ---------------------------------------------------------------------------
#  PostgreSQL — the source of financial truth
#
#  Two roles by design (DATABASE.md §7): the role serving traffic cannot
#  reshape the schema, and cannot delete money.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://goti_app:change-me@localhost:5432/goti?schema=public&connection_limit=20&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://goti_migrator:change-me@localhost:5432/goti?schema=public"

# ---------------------------------------------------------------------------
#  Redis — cache and coordination ONLY. Never the source of financial truth.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for a local instance with no auth configured.
REDIS_PASSWORD=
REDIS_DB=0

# Prefixed onto every key so several environments can share one Redis instance
# without colliding, and so a whole environment can be identified in `SCAN`.
REDIS_KEY_PREFIX=goti:dev

# Fail fast rather than queueing commands while disconnected. Redis is optional
# to correctness, so a hung command is worse than a failed one.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_MAX_RETRIES_PER_REQUEST=2

# Circuit breaker: after this many consecutive failures, Redis is skipped
# entirely for the cooldown period instead of every request paying a timeout.
REDIS_CIRCUIT_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_COOLDOWN_MS=10000

# TLS — required for managed Redis (ElastiCache, Upstash, Redis Cloud).
REDIS_TLS_ENABLED=false

# ---------------------------------------------------------------------------
#  Idempotency (REDIS.md §2)
#
#  Two TTLs, deliberately. The in-flight lock is short so a crashed process
#  cannot block a key for a day; the stored result is long so a client retrying
#  hours later still gets the original answer instead of a second payment.
# ---------------------------------------------------------------------------
IDEMPOTENCY_INFLIGHT_TTL_SECONDS=60
IDEMPOTENCY_RESULT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
#  Rate limiting (REDIS.md §3) — sliding window counter
# ---------------------------------------------------------------------------
RATE_LIMIT_TRANSACTION_MAX=100
RATE_LIMIT_TRANSACTION_WINDOW_SECONDS=60
# When Redis is unavailable the limiter falls back to a per-instance counter.
# Set generously: it is a backstop against a stampede, not a precise quota.
RATE_LIMIT_FALLBACK_MAX_PER_INSTANCE=200

# ---------------------------------------------------------------------------
#  Cache TTLs (REDIS.md §4)
#
#  Balance TTL is deliberately tiny. A stale balance in a money app is a
#  support ticket, and the underlying query is a primary-key lookup that
#  PostgreSQL already answers in well under a millisecond.
# ---------------------------------------------------------------------------
CACHE_WALLET_BALANCE_TTL_SECONDS=5
CACHE_RECENT_TRANSACTIONS_TTL_SECONDS=30
# Random extra TTL (0..N seconds) so keys created together do not all expire
# together and stampede the database.
CACHE_TTL_JITTER_SECONDS=3
